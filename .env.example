# ─────────────────────────────────────────────────────────────
# NCVR — Nite Cap Vibe Radio · example environment
# Copy to .env and fill in. NEVER commit real values.
# Anything without NEXT_PUBLIC_ stays on the server.
# ─────────────────────────────────────────────────────────────

# Public URL of this app (used for links in invites, Stripe redirects)
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://ncvr:ncvr@localhost:5432/ncvr?schema=public

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Set true when running behind a trusted HTTPS reverse proxy
AUTH_TRUST_HOST=true

# ── AzuraCast (broadcast engine) ─────────────────────────────
# Base URL of your AzuraCast install, no trailing slash
AZURACAST_BASE_URL=
# Numeric ID or short name of the NCVR station in AzuraCast
AZURACAST_STATION_ID=
# Station short name (used for the public Web DJ + webcast websocket path)
AZURACAST_STATION_SHORTCODE=
# API key created in AzuraCast → My Account → API Keys (server-only!)
AZURACAST_API_KEY=
# Public listen URL of the mount listeners should hear (e.g. https://stream.capriojacksoncoded.si/listen/ncvr/radio.mp3)
# Leave empty to use the listen_url reported by the AzuraCast Now Playing API.
NEXT_PUBLIC_STREAM_URL=
# Show listener counts publicly? (station owner decision)
NEXT_PUBLIC_SHOW_LISTENER_COUNT=false

# ── Studio transmission ──────────────────────────────────────
# WebSocket URL of the AzuraCast Web DJ / Liquidsoap harbor webcast input.
# Usually wss://<azuracast-host>/webdj/<station_shortcode>/
NEXT_PUBLIC_WEBCAST_URL=

# ── Guest rooms (LiveKit WebRTC) ─────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Payments (optional, Stripe) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Storage ──────────────────────────────────────────────────
# Where uploaded audio/artwork is kept (outside the web root)
UPLOAD_DIR=./uploads
# Max upload size in megabytes
MAX_UPLOAD_MB=200

# Station timezone for programming (DST observed)
STATION_TIMEZONE=America/New_York
NEXT_PUBLIC_CONTACT_EMAIL=

# docker compose only: password for the bundled Postgres
POSTGRES_PASSWORD=
