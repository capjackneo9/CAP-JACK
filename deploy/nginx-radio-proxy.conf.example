# OPTIONAL — only if the existing capriojacksoncoded.si server is nginx you control
# and you want NCVR to appear under capriojacksoncoded.si/radio instead of redirecting.
# Review with whoever manages the main site first; this file is NOT applied automatically.
location /radio      { proxy_pass https://nitecapviberadio.tech; proxy_set_header Host nitecapviberadio.tech; }
location /_next/     { proxy_pass https://nitecapviberadio.tech; proxy_set_header Host nitecapviberadio.tech; }
location /api/radio/ { proxy_pass https://nitecapviberadio.tech; proxy_set_header Host nitecapviberadio.tech; proxy_buffering off; }
location /api/media/ { proxy_pass https://nitecapviberadio.tech; proxy_set_header Host nitecapviberadio.tech; }
location /brand/     { proxy_pass https://nitecapviberadio.tech; proxy_set_header Host nitecapviberadio.tech; }
# Simpler alternative (works on any host incl. shared hosting / .htaccess):
#   Redirect 302 /radio https://nitecapviberadio.tech/radio
