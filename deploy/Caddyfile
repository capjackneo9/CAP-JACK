# Host-level Caddy for srv2118691.hstgr.cloud (Hostinger KVM 4).
# Caddy owns ports 80/443 and gets TLS certificates automatically.
# AzuraCast is moved to internal ports 8080/8443 (see docs/DEPLOYMENT.md).

# Public NCVR site. The app redirects / to /radio.
nitecapviberadio.tech {
	encode zstd gzip
	# NCVR TV live video (MediaMTX HLS)
	handle_path /live-hls/* {
		reverse_proxy 127.0.0.1:8888
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

www.nitecapviberadio.tech {
	redir https://nitecapviberadio.tech{uri} permanent
}

# Private studio — same app; middleware serves /studio for this host.
studio.nitecapviberadio.tech {
	encode zstd gzip
	# NCVR TV live video (MediaMTX HLS)
	handle_path /live-hls/* {
		reverse_proxy 127.0.0.1:8888
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# AzuraCast: admin UI, public API, /listen streams and the /webdj websocket.
stream.nitecapviberadio.tech {
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}

